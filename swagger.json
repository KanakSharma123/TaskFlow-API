{
  "swagger": "2.0",

  "info": {
    "title": "TaskFlow API",
    "description": "Task Management REST API",
    "version": "1.0"
  },

  "basePath": "/",

  "schemes": [
    "http"
  ],

  "paths": {

    "/register": {

      "post": {

        "summary": "Create user",

        "parameters": [

          {
            "in":"body",
            "name":"body",
            "schema":{

              "type":"object",

              "properties":{

                "username":{
                  "type":"string"
                },

                "password":{
                  "type":"string"
                }

              }

            }
          }

        ],

        "responses":{

          "200":{
            "description":"User created"
          }

        }

      }

    },


    "/login":{

      "post":{

        "summary":"Login user",

        "responses":{

          "200":{
            "description":"JWT token generated"
          }

        }

      }

    },


    "/projects":{

      "post":{

        "summary":"Create project",

        "responses":{

          "200":{
            "description":"Project created"
          }

        }

      },


      "get":{

        "summary":"Get projects",

        "responses":{

          "200":{
            "description":"List projects"
          }

        }

      }

    }

  }

}